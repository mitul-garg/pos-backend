<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pos</groupId>
  <artifactId>pos-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>PoS Backend</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <spring.version>6.2.8</spring.version>
    <!--
      Spring Security 6.4.x is the line built against Spring Framework 6.2. 6.5+
      moves to Framework 7, the same mismatch that pins Hibernate below.
    -->
    <spring.security.version>6.4.4</spring.security.version>
    <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
    <!--
      Hibernate 6.6, not 7.x. Hibernate 7 moved to Jakarta Persistence 3.2, which
      Spring only supports from Framework 7; Spring 6.2's spring-orm is built
      against JPA 3.1. Pairing 6.2 with Hibernate 7 fails at runtime, not at compile.
    -->
    <hibernate.version>6.6.55.Final</hibernate.version>
    <!-- Matches the MySQL 9.7 server this is developed against. -->
    <mysql.connector.version>9.7.0</mysql.connector.version>
    <hikaricp.version>6.3.3</hikaricp.version>
    <jackson.version>2.18.3</jackson.version>
    <slf4j.version>2.0.17</slf4j.version>
    <log4j2.version>2.24.3</log4j2.version>
    <hibernate.validator.version>8.0.2.Final</hibernate.validator.version>
    <expressly.version>5.0.0</expressly.version>
    <jjwt.version>0.12.7</jjwt.version>
    <swagger.version>2.2.30</swagger.version>
    <swagger.ui.version>5.20.1</swagger.ui.version>
    <junit.version>5.11.4</junit.version>
    <jsonpath.version>2.9.0</jsonpath.version>
    <hamcrest.version>3.0</hamcrest.version>
    <jetty.version>12.0.16</jetty.version>
    <jacoco.version>0.8.15</jacoco.version>
    <angus.mail.version>2.0.5</angus.mail.version>
    <jakarta.mail.version>2.1.3</jakarta.mail.version>
    <google.auth.version>1.48.0</google.auth.version>
  </properties>

  <dependencies>
    <!--
      Spring MVC. Pulls spring-core/beans/context/web/aop/expression transitively,
      which is the whole DI container plus DispatcherServlet. No Spring Boot:
      everything Boot would auto-configure is written by hand in com.pos.config.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>${spring.version}</version>
    </dependency>

    <!--
      Servlet 6.0 (Jakarta EE 10) — the namespace Spring 6 and Jetty 12's ee10
      module both speak. `provided` because the container supplies it; shipping a
      second copy in the WAR causes classloader conflicts with Jetty's.
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${jakarta.servlet.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Persistence (C2). spring-orm supplies LocalContainerEntityManagerFactoryBean
      and JpaTransactionManager — the two beans Boot would auto-configure — and
      pulls spring-jdbc/spring-tx transitively.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-orm</artifactId>
      <version>${spring.version}</version>
    </dependency>

    <!--
      Hibernate ORM: the JPA provider, and the source of the schema itself
      (hbm2ddl) since there is no migration tool. Also brings jakarta.persistence-api.
    -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>

    <!--
      `runtime` scope on purpose: nothing in com.pos may import a driver class.
      Compiling against it is how a JDBC URL ends up hardcoded in a service.
    -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      Connection pool. Explicit rather than inherited: free-tier MySQL caps
      connections at 5-20 and Hikari's default maximumPoolSize of 10 will exhaust
      it (backend-plan.md 3), so PersistenceConfig sets the size by hand.
    -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>

    <!--
      Security (C3). spring-security-config carries @EnableWebSecurity and the
      HttpSecurity DSL; spring-security-web carries the filter chain and
      AbstractSecurityWebApplicationInitializer, which registers it in place of the
      <filter> element a web.xml would have held. spring-security-core comes
      transitively and brings BCryptPasswordEncoder with it.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
      <version>${spring.security.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
      <version>${spring.security.version}</version>
    </dependency>

    <!--
      JWT. Split into three artifacts on purpose: only jjwt-api is a compile
      dependency, so nothing in com.pos can accidentally import an implementation
      class. The other two are `runtime` and are located by ServiceLoader.
      jjwt-jackson is the JSON serializer jjwt needs for the claims payload; omit
      it and token creation fails at runtime with "cannot find a JSON serializer",
      not at compile time.
    -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      Mail (C9, tenant-registration-plan.md). The first new runtime dependency this
      project has added since C1 through C8, worth calling out: everything else so far
      leaned on what spring-webmvc/spring-orm/spring-security already pulled in.

      spring-context-support supplies JavaMailSenderImpl — Boot-free, hand-wired the
      same way HikariConfig/JpaTransactionManager are: no auto-configuration, MailConfig
      builds it explicitly from AppProperties. It only compiles against the jakarta.mail
      *API*; angus-mail is the actual SMTP implementation (the Eclipse Foundation's
      Jakarta EE 10 successor to the old javax.mail/Sun JavaMail), `runtime`-scoped so
      nothing in com.pos can import an implementation class — the identical reasoning
      jjwt-impl/jjwt-jackson already follow above.

      jakarta.mail-api is declared explicitly, not left to arrive transitively off
      angus-mail: a transitive dependency's scope is capped by its parent's, so left
      implicit it would be `runtime` too — and JavaMailSender's own interface (in
      spring-context-support) references jakarta.mail.internet.MimeMessage in its
      signature, which javac needs to resolve at COMPILE time even though
      JavaMailEmailSender only ever calls the SimpleMailMessage overload. Same device as
      jjwt-api above: the API compile-scoped, the implementation runtime-scoped.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context-support</artifactId>
      <version>${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>${jakarta.mail.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>${angus.mail.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      Product images via GCS (peer-review Phase 3) — loads the signing service
      account's JSON key and provides the RSA-signing primitive V4 signed URLs
      need, plus OAuth2 token minting for the one plain REST call this feature
      makes (deleting an object). Deliberately NOT com.google.cloud:google-cloud-
      storage: that SDK's dependency tree (verified locally with `mvn
      dependency:tree` before choosing) pulls in the full gRPC stack — including
      xDS/service-mesh and grpc-alts — plus OpenTelemetry's SDK, OpenCensus, and
      even a transitive Cloud Monitoring client, wildly disproportionate for
      "sign a URL and delete a blob" on a 1GB VM already tuned tight
      (iac/prompts/02-compute-and-deploy.md). This library's own tree is just
      guava + a thin google-http-client + gson — no gRPC, no protobuf. The V4
      signing algorithm's canonical-request construction is hand-rolled in
      GcsImageSigner against this library's ServiceAccountCredentials.sign(),
      the same "reach for a library only once hand-rolling stops being simple"
      instinct GoogleRecaptchaVerifier's Javadoc names — this library supplies
      the one primitive (RSA-SHA256 signing with a securely-parsed key) that
      would be unwise to hand-roll, while the actual canonicalization logic
      (well documented by Google, mechanical once written) stays in our code.
      Local signing also has zero per-request network cost, unlike signing via
      the IAM Credentials API — see iac/requirements.md decision #21 for why
      that mattered to this design.
    -->
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
      <version>${google.auth.version}</version>
    </dependency>

    <!-- JSON. Spring ships no mapper; this is what MappingJackson2HttpMessageConverter needs. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Without this, java.time values serialize as numeric arrays instead of ISO-8601. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!--
      Bean Validation, so @Valid on a Form DTO raises MethodArgumentNotValidException
      and the @ControllerAdvice can answer 400 with field -> message.
      (Hibernate Validator is unrelated to Hibernate ORM, which arrives in C2.)
    -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>${hibernate.validator.version}</version>
    </dependency>
    <!-- Validator ships only the EL *API*; message interpolation needs an implementation. -->
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>${expressly.version}</version>
    </dependency>

    <!--
      OpenAPI. swagger-core builds the spec model and derives JSON Schema from our
      DTOs; the webjar is the UI. Both are Boot-free — deliberately NOT springdoc,
      which hard-depends on spring-boot-autoconfigure. The Spring-MVC-to-OpenAPI
      step that springdoc would provide is OpenApiGenerator instead.
    -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-core-jakarta</artifactId>
      <version>${swagger.version}</version>
    </dependency>
    <dependency>
      <groupId>org.webjars</groupId>
      <artifactId>swagger-ui</artifactId>
      <version>${swagger.ui.version}</version>
    </dependency>

    <!--
      Logging (requirements.md 1). Spring logs via spring-jcl, which delegates to
      SLF4J when present, so this trio routes framework output into Log4j2:
      slf4j-api is the facade, log4j-slf4j2-impl the binding, log4j-core the engine
      that reads log4j2.xml. Omit the binding and Spring's logs vanish into JUL.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j2.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- MockMvc: exercises the real WebConfig and @ControllerAdvice without booting Jetty. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <version>${spring.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- jsonPath(..) assertions on MockMvc responses; spring-test treats both as optional. -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>${jsonpath.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>${hamcrest.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      SecurityMockMvcConfigurers.springSecurity(), which inserts the real filter
      chain in front of MockMvc. Without it AuthControllerIT would call controllers
      directly and never exercise the thing C3 is mostly about.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <version>${spring.security.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>pos-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!--
            Required, not cosmetic. Spring 6 dropped bytecode-based parameter name
            discovery, so without -parameters an unnamed @PathVariable/@RequestParam
            fails at runtime — and OpenApiGenerator could not name them either.
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <!-- No web.xml — WebAppInitializer bootstraps the DispatcherServlet instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>

      <!-- Surefire 2.x cannot run JUnit 5; 3.x does so natively. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!--
            `*IT` is Failsafe's naming convention, run by `mvn verify`. We run them
            in Surefire instead so that `mvn test` is the single verification
            command the conventions ask for before every commit — an isolation
            suite that only runs under a second command is an isolation suite that
            stops being run. Cost: `mvn test` needs pos_test to exist (README).

            Listing includes REPLACES Surefire's defaults, so the standard four
            patterns are restated here rather than inherited.
          -->
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>

      <!--
        `mvn jetty:run` resolves this prefix from the POM. Jetty 12 splits by EE
        version and ee10 is the jakarta.servlet 6.0 one; the plain
        jetty-maven-plugin coordinate is the older javax build.
      -->
      <plugin>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-maven-plugin</artifactId>
        <version>${jetty.version}</version>
        <configuration>
          <webApp>
            <contextPath>/</contextPath>
          </webApp>
          <!--
            Dev seeding is a property of THIS GOAL, not of the artifact.

            `mvn jetty:run` is the local-development command and nothing else uses
            it, so turning the seeder on here means a developer never passes a
            flag, while the WAR that gets deployed cannot seed no matter how it is
            configured: pos.seed.dev still defaults to false in
            application.properties, and a deployed container never runs this
            plugin. That is a stronger guarantee than "remember to set
            POS_SEED_DEV=false in production", because forgetting it is not an
            option that exists.

            The seeder creates admin accounts whose passwords are in the README,
            which is why it is worth this much care.
          -->
          <systemProperties>
            <POS_SEED_DEV>true</POS_SEED_DEV>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Coverage, on request: `mvn test -Pcoverage`, then open
    target/site/jacoco/index.html.

    Behind a profile rather than always-on so that `mvn test`, the command
    CONVENTIONS.md asks you to run before every commit, stays exactly as fast as
    it is today. The JaCoCo agent is cheap but not free, and a verification
    command people run dozens of times a day is the wrong place to spend it.

    No `check` goal, deliberately. A coverage threshold chosen before anyone has
    seen the baseline is a threshold that gets lowered the first time it is
    inconvenient, which teaches people the number is negotiable. Add one when
    there is a real figure to hold the line at.

    Read the number with one caveat in mind: 50 of the 128 tests need a local
    pos_test (../README.md). On a machine without MySQL those suites error and
    the report understates coverage dramatically rather than failing, because
    persistence and security are precisely the parts only they reach.

    Keep jacoco.version ahead of the JDK Maven runs on. The agent has to read
    the class file version the JVM emits, and when it cannot it prints a stack
    trace per class and drops them from the report while the build still passes
    green. 0.8.13 could not read JDK 26's version 70; 0.8.15 can.
  -->
  <profiles>
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <!--
                Sets the `argLine` property that Surefire passes to the forked
                JVM. Surefire picks it up on its own precisely because nothing
                in this POM sets argLine by hand. If that ever changes, the
                hand-written value has to include @{argLine} or coverage
                silently reports zero.
              -->
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <!--
                Bound to `test`, not the goal's default `verify` phase. This
                project runs its *IT suites under Surefire rather than Failsafe
                (see maven-surefire-plugin above), so everything worth measuring
                has already run by the end of `test` and `mvn test -Pcoverage`
                is a complete command on its own.
              -->
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
